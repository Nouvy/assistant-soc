# Modèle des variables d'environnement — copier en `.env` et remplir les valeurs.
# Ne jamais mettre de vraie clé ici : ce fichier est versionné.

GEMINI_API_KEY=

# --- Modèle local (Ollama) ---
# Optionnelle : l'API Ollama écoutée par défaut. Aucune clé, le service est local.
OLLAMA_HOST=

# --- Backend FastAPI (api/) ---
# Optionnelles : valeurs par défaut utilisées au lancement du serveur de dev.
#   uv run uvicorn main:app --reload --host 127.0.0.1 --port 8000
API_HOST=
API_PORT=
